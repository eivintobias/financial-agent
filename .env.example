# Copy this file to .env and fill in your values.
# Leave USE_MOCK_LLM=true to run the whole demo/tests fully OFFLINE (no API key).
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
USE_MOCK_LLM=true
# manual = HIGH-risk actions wait for a human y/N at the console
# auto   = approvals granted programmatically (for CI/testing only)
APPROVAL_MODE=manual
# Override to redirect all runtime data (audit log, chroma db, crm.json)
#DATA_DIR=